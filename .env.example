# Database
AETHER_DATABASE_URL=sqlite:///./aether.db

# REQUIRED for v1.0 authentication. Generate a unique 32+ character random value.
AETHER_JWT_SECRET=REPLACE_WITH_64_HEX_CHAR_SECRET

# REQUIRED once, for creating the first platform administrator. Remove/rotate after bootstrap.
AETHER_BOOTSTRAP_KEY=REPLACE_WITH_ONE_TIME_RANDOM_SECRET

# Optional shared API perimeter key (in addition to JWT user authentication)
AETHER_API_KEY=

# Comma-separated exact frontend origins. Do not use wildcard origins in production.
AETHER_CORS_ORIGINS=https://your-aether-domain.example

# Optional provider identifiers. Credentials belong in a secret manager/environment,
# not in source control or the database.
AETHER_MARKET_DATA_PROVIDER=
ZERODHA_CLIENT_ID=
ZERODHA_CLIENT_SECRET=
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
ANGELONE_CLIENT_ID=
ANGELONE_CLIENT_SECRET=
FYERS_CLIENT_ID=
FYERS_CLIENT_SECRET=

# Never set AETHER_ENV=test outside isolated automated tests.
\n# AETHER AutoTrader v2.0 — paper-only controls\nAETHER_PAPER_INITIAL_CAPITAL=50000\nAETHER_PAPER_RISK_PER_TRADE=0.01\nAETHER_PAPER_DAILY_LOSS_LIMIT=0.02\nAETHER_PAPER_MAX_POSITION=0.25\nAETHER_PAPER_MAX_GROSS_EXPOSURE=1.0\nAETHER_PAPER_COST_BPS=5.0\nAETHER_PAPER_SLIPPAGE_BPS=2.5\nGROWW_ACCESS_TOKEN=\n

# Groww API connection and live execution — ALL OFF BY DEFAULT.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GROWW_TOKEN_ENCRYPTION_KEY=
AETHER_LIVE_TRADING_ENABLED=false
AETHER_GROWW_ALGO_APPROVED=false
AETHER_AUTO_WORKER_ENABLED=false
AETHER_AUTO_WORKER_INTERVAL_SECONDS=60
AETHER_LIVE_CAPITAL=50000
AETHER_LIVE_RISK_PER_TRADE=0.01
AETHER_LIVE_MAX_ORDER_VALUE=12500
AETHER_LIVE_MAX_DAILY_ORDERS=5
AETHER_LIVE_MAX_DAILY_NOTIONAL=50000
AETHER_ALLOW_INSECURE_GROWW_CONNECT=false
